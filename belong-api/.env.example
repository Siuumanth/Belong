# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=belong
POSTGRES_USER=belong_user
POSTGRES_PASSWORD=belong_password
DATABASE_URL=postgresql://belong_user:belong_password@localhost:5432/belong

# RabbitMQ Configuration
RABBITMQ_URL=amqp://belong:belong_password@localhost:5672/
RABBITMQ_EXCHANGE=belong.jobs

# LLM Provider Configuration (options: groq, google, openai, anthropic)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# LLM API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MAX_FOLLOW_UPS=2

# Embeddings & HuggingFace Configuration
# Set USE_LOCAL_EMBEDDINGS=true to run sentence-transformers locally (no API key needed)
# Set USE_LOCAL_EMBEDDINGS=false to use HuggingFace Inference API
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_API_TOKEN=hf_your_huggingface_token_here
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here
