POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=belong
POSTGRES_USER=belong_user
POSTGRES_PASSWORD=belong_password
DATABASE_URL=postgresql://belong_user:belong_password@localhost:5432/belong

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.7
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MAX_FOLLOW_UPS=2

# External APIs
HUGGINGFACE_API_KEY=your_huggingface_key_here
