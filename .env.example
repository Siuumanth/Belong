# ==============================================================================
# BELONG PLATFORM - GLOBAL ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=belong
POSTGRES_USER=belong_user
POSTGRES_PASSWORD=belong_password
DATABASE_URL=postgresql://belong_user:belong_password@postgres:5432/belong
AUTH_POSTGRES_URL_DEV=postgres://belong_user:belong_password@postgres:5432/belong?sslmode=disable

# ------------------------------------------------------------------------------
# 2. RabbitMQ Message Queue Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=belong
RABBITMQ_DEFAULT_PASS=belong_password
RABBITMQ_URL=amqp://belong:belong_password@rabbitmq:5672/
RABBITMQ_EXCHANGE=belong.jobs
RABBITMQ_QUEUE_EMBEDDING=belong.embedding
RABBITMQ_QUEUE_MATCHING=belong.matching

# ------------------------------------------------------------------------------
# 3. Microservice Ports & Routing (Gateway, Auth, API)
# ------------------------------------------------------------------------------
GATEWAY_PORT=9000
AUTH_PORT=9001
API_PORT=8000
AUTH_SERVICE_URL=http://belong-auth:9001
BELONG_SERVICE_URL=http://belong-api:8000
JWT_SECRET=chubsmanprodude
JWT_EXPIRES_IN=5h

# ------------------------------------------------------------------------------
# 4. LLM Configuration (Groq, Google Gemini, OpenAI, Anthropic)
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
MAX_FOLLOW_UPS=2

# --- LLM API KEYS (FILL YOUR KEYS HERE) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. Embeddings & Hugging Face Configuration
# ------------------------------------------------------------------------------
# Set USE_LOCAL_EMBEDDINGS=true to run sentence-transformers locally (no HF API key required)
# Set USE_LOCAL_EMBEDDINGS=false to use HuggingFace Inference API
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_API_TOKEN=hf_your_huggingface_token_here
HUGGINGFACE_API_KEY=hf_your_huggingface_key_here
